{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aa228-werewolf.local/schema/game_log.schema.json",
  "title": "Werewolf game log",
  "description": "Replay log for one game of Werewolf. Produced by the simulator (or the mock generator), consumed by the viewer. Version 1.0.0.",
  "type": "object",
  "required": ["meta", "players", "steps", "result"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "seed", "config", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "seed": { "type": "integer" },
        "config": {
          "type": "object",
          "description": "Free-form simulator configuration. `role_counts` is recommended so the viewer can show the setup.",
          "properties": {
            "role_counts": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/role" },
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "description": "Optional human-readable name for the game." },
        "mock": { "type": "boolean", "description": "True for hand-scripted mock logs." }
      }
    },

    "players": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "team", "personality"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/playerId" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/$defs/role" },
          "team": { "$ref": "#/$defs/team" },
          "personality": { "$ref": "#/$defs/personality" }
        }
      }
    },

    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },

    "result": {
      "type": "object",
      "required": ["winner", "final_round", "eliminations"],
      "additionalProperties": false,
      "properties": {
        "winner": { "$ref": "#/$defs/team" },
        "final_round": { "type": "integer", "minimum": 0 },
        "eliminations": {
          "type": "array",
          "description": "Every death, in order.",
          "items": {
            "type": "object",
            "required": ["player", "round", "phase", "cause"],
            "additionalProperties": false,
            "properties": {
              "player": { "$ref": "#/$defs/playerId" },
              "round": { "type": "integer", "minimum": 0 },
              "phase": { "$ref": "#/$defs/phase" },
              "t": { "type": "integer", "minimum": 0, "description": "Step at which the death happened." },
              "cause": { "enum": ["wolves", "vote", "poison", "caught_spying", "heartbreak"] }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "playerId": { "type": "string", "pattern": "^p[0-9]{2}$" },
    "role": { "enum": ["werewolf", "seer", "witch", "little_girl", "villager", "cupid"] },
    "team": { "enum": ["village", "werewolves", "lovers"] },
    "personality": { "enum": ["aggressive", "discreet", "manipulative", "trusting"] },
    "phase": { "enum": ["setup", "night", "day", "end"] },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },

    "step": {
      "type": "object",
      "required": ["t", "round", "phase", "events", "beliefs", "decisions"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "integer", "minimum": 0 },
        "round": { "type": "integer", "minimum": 0 },
        "phase": { "$ref": "#/$defs/phase" },
        "subphase": {
          "type": "string",
          "description": "Display label only, e.g. wolves, seer, witch, dawn, conversations, debate, vote, runoff."
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "beliefs": {
          "type": "object",
          "description": "observer id -> target id -> role -> probability. One entry per living observer, covering every other player. Each target's role distribution sums to 1.",
          "propertyNames": { "$ref": "#/$defs/playerId" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/playerId" },
            "additionalProperties": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/role" },
              "additionalProperties": { "$ref": "#/$defs/probability" }
            }
          }
        },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
      }
    },

    "visibility": {
      "oneOf": [
        { "const": "all" },
        { "type": "array", "items": { "$ref": "#/$defs/playerId" }, "uniqueItems": true }
      ]
    },

    "event": {
      "type": "object",
      "required": ["type", "actor", "target", "payload", "visible_to"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "role_assigned", "pack_revealed",
            "spy", "wolf_target", "inspect", "potion",
            "dawn", "death_announced",
            "conversation", "impression", "statement",
            "vote", "vote_result", "elimination",
            "game_end",
            "lovers_bound", "captain_elected"
          ]
        },
        "actor": { "oneOf": [{ "$ref": "#/$defs/playerId" }, { "type": "null" }] },
        "target": { "oneOf": [{ "$ref": "#/$defs/playerId" }, { "type": "null" }] },
        "payload": { "type": "object" },
        "visible_to": { "$ref": "#/$defs/visibility" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "role_assigned" } } },
          "then": { "properties": { "payload": { "required": ["role"], "properties": { "role": { "$ref": "#/$defs/role" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "pack_revealed" } } },
          "then": { "properties": { "payload": { "required": ["members"], "properties": { "members": { "type": "array", "items": { "$ref": "#/$defs/playerId" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "spy" } } },
          "then": { "properties": { "payload": {
            "required": ["outcome"],
            "properties": {
              "outcome": { "enum": ["nothing", "glimpsed", "caught"] },
              "glimpsed": { "$ref": "#/$defs/playerId" }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "inspect" } } },
          "then": { "properties": { "payload": { "required": ["role"], "properties": { "role": { "$ref": "#/$defs/role" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "potion" } } },
          "then": { "properties": { "payload": { "required": ["kind"], "properties": { "kind": { "enum": ["heal", "poison"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "dawn" } } },
          "then": { "properties": { "payload": { "required": ["deaths"], "properties": { "deaths": { "type": "array", "items": { "$ref": "#/$defs/playerId" } } } } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["death_announced", "elimination"] } } },
          "then": { "properties": { "payload": { "required": ["role"], "properties": { "role": { "$ref": "#/$defs/role" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "impression" } } },
          "then": { "properties": { "payload": { "required": ["verdict"], "properties": { "verdict": { "enum": ["convincing", "suspicious"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "statement" } } },
          "then": { "properties": { "payload": {
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["accuse", "defend", "claim_role", "quiet"] },
              "claimed_role": { "$ref": "#/$defs/role" },
              "text": { "type": "string" }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "vote" } } },
          "then": { "properties": { "payload": { "properties": { "ballot": { "enum": ["main", "runoff"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "vote_result" } } },
          "then": { "properties": { "payload": {
            "required": ["tally", "tied", "eliminated"],
            "properties": {
              "tally": { "type": "object", "propertyNames": { "$ref": "#/$defs/playerId" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
              "tied": { "type": "boolean" },
              "runoff": { "type": "boolean", "description": "True if a runoff between tied players follows." },
              "ballot": { "enum": ["main", "runoff"] },
              "eliminated": { "oneOf": [{ "$ref": "#/$defs/playerId" }, { "type": "null" }] }
            }
          } } }
        },
        {
          "if": { "properties": { "type": { "const": "game_end" } } },
          "then": { "properties": { "payload": { "required": ["winner"], "properties": { "winner": { "$ref": "#/$defs/team" } } } } }
        }
      ]
    },

    "decision": {
      "type": "object",
      "required": ["player", "kind", "options", "chosen"],
      "additionalProperties": false,
      "properties": {
        "player": { "$ref": "#/$defs/playerId" },
        "kind": { "enum": ["wolf_target", "spy", "inspect", "potion", "talk_to", "statement", "vote"] },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action", "value"],
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string", "description": "Machine-readable action name, e.g. vote, inspect, heal, poison, pass, accuse, claim_seer." },
              "target": { "oneOf": [{ "$ref": "#/$defs/playerId" }, { "type": "null" }] },
              "value": { "type": "number", "description": "Planner's estimated value of the option (higher is better)." },
              "label": { "type": "string", "description": "Optional human-readable label." }
            }
          }
        },
        "chosen": { "type": "integer", "minimum": 0, "description": "Index into options." }
      }
    }
  }
}
